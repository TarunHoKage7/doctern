# Local model runtime (Ollama on loopback). No cloud calls in the clinical loop.
OLLAMA_URL=http://127.0.0.1:11434
# gemini_api = hosted Gemma 4 (online); ollama = local Gemma 4 E2B/E4B (offline)
GEMMA_BACKEND=gemini_api
GEMMA_MODEL=gemma-4-31b-it
MEDGEMMA_MODEL=medgemma:4b
CALL_TIMEOUT_S=120
RUN_BUDGET_S=420
# Used for hosted Gemma 4 when GEMMA_BACKEND=gemini_api
GEMINI_API_KEY=
